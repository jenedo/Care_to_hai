# AsaanCare API Server — copy to .env and fill values (never commit .env)

PORT=3000
NODE_ENV=development

# Database (required) — copy connection string from Neon dashboard
DATABASE_URL=postgresql://neondb_owner:npg_tbIOW3aqAXQ4@ep-billowing-night-aoq0gj4a.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Clerk (required)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Appwrite — files only (server-side)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=asaancare
APPWRITE_BUCKET_ID=doctor-documents

# LiveKit — video/audio (replaces Agora)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Payments (when integrated)
JAZZCASH_WEBHOOK_SECRET=
EASYPAISA_WEBHOOK_SECRET=

# CORS (production)
ADMIN_WEB_URL=https://admin.yourdomain.com

# Optional
ADMIN_NOTIFICATION_USER_IDS=
LOG_LEVEL=debug
